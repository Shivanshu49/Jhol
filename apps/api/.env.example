# Copy to apps/api/.env for local dev. On Railway, set these as service variables instead.

# api | worker | all   (all = both in one process; use for local dev)
ROLE=all
PORT=4000

# Browser agent's step-by-step LLM: cerebras (default) | openai
AGENT_LLM=cerebras
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
# OpenAI: used when AGENT_LLM=openai, and always by the LLM judge (no key → audits finish with rule findings only)
OPENAI_API_KEY=
OPENAI_MODEL=
# optional: any OpenAI-compatible endpoint
OPENAI_BASE_URL=

# Let audits open localhost / private networks (the test store on :5050). Local dev only; never in production.
ALLOW_PRIVATE_TARGETS=true

# Exa — legal precedents under each finding (optional: audits finish without them)
EXA_API_KEY=

# Supabase — Project Settings → API keys (use the SECRET / service_role key, never the publishable one)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Redis for BullMQ — local: docker compose up -d   ·   Railway: copy the Redis service's REDIS_URL
REDIS_URL=redis://localhost:6379

# Shared secret between the web app and this API (any long random string; same value in apps/web)
JHOL_API_KEY=

# Optional: separate demo store repo and the URL where it is served.
# Codex CLI must be installed and logged in. A GitHub origin + gh login enables PRs; otherwise fixes stay local.
FIX_REPO_PATH=
FIX_STORE_URL=http://localhost:5051/index.html
