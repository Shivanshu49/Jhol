# Copy to apps/api/.env for local dev. On Railway, set these as service variables instead.

# api | worker | all   (all = both in one process; use for local dev)
ROLE=all
PORT=4000

# TinyFish — agent.tinyfish.ai/api-keys
TINYFISH_API_KEY=

# Supabase — Project Settings → API keys (use the SECRET / service_role key, never the publishable one)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Redis for BullMQ — local: docker compose up -d   ·   Railway: copy the Redis service's REDIS_URL
REDIS_URL=redis://localhost:6379

# Shared secret between the web app and this API (any long random string; same value in apps/web)
JHOL_API_KEY=

# TinyFish calls  {PUBLIC_API_URL}/webhooks/tinyfish?token={WEBHOOK_SECRET}  when a run changes.
# Needs a public https URL, so leave PUBLIC_API_URL empty locally (polling still works).
PUBLIC_API_URL=
WEBHOOK_SECRET=

# Optional: enables the LLM judge for wording-based dark patterns
ANTHROPIC_API_KEY=
JUDGE_MODEL=claude-haiku-5-5
