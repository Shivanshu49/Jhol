# Copy to apps/web/.env.local for local dev. On Vercel, add these in Project → Settings → Environment Variables.
# Both are server-only (no NEXT_PUBLIC_ prefix) — the browser never sees them.

# Where the Jhol API runs — local: http://localhost:4000 · prod: your Railway api URL
API_URL=http://localhost:4000

# Same value as JHOL_API_KEY in apps/api
JHOL_API_KEY=
