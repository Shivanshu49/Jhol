{
  "name": "@jhol/core",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright + OpenAI checkout agent and dark-pattern detectors shared by the Jhol api and worker",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/*.test.cjs\"",
    "agent": "node --env-file-if-exists=../../apps/api/.env dist/cli.js",
    "eval": "node --env-file-if-exists=../../apps/api/.env dist/eval.js"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "exa-js": "^2.27.0",
    "openai": "^7.47.0",
    "playwright": "^1.64.1"
  }
}
